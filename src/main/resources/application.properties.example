spring.application.name=AgroPiuraIoT

# PostgreSQL local — BD creada según DDL del informe (13 tablas)
spring.datasource.url=jdbc:postgresql://localhost:5432/agropiura
spring.datasource.username=postgres
spring.datasource.password=password
spring.datasource.driver-class-name=org.postgresql.Driver

# El esquema lo gobierna database/query.sql del informe, solo validar
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# RF-06 — Clima de terceros (OpenWeatherMap). Sin API key el clima se
# desactiva de forma elegante (no aparece en el dashboard, no hay errores).
# Recomendado: definir la clave como variable de entorno (nunca en el repo).
clima.openweather.api-key=${OPENWEATHER_API_KEY:}
# Base URL del proveedor (por defecto la API 2.5 oficial)
# clima.openweather.url=https://api.openweathermap.org/data/2.5
# Minutos de cache por ubicación (Guava) para respetar el límite del plan gratuito
# clima.cache.minutos=30
