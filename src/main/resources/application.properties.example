spring.application.name=AgroPiuraIoT

# PostgreSQL local — BD creada según DDL del informe (13 tablas) + database/indices.sql
spring.datasource.url=${DB_URL:jdbc:postgresql://localhost:5432/agropiura}
spring.datasource.username=${DB_USER:postgres}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.driver-class-name=org.postgresql.Driver

# El esquema lo gobierna database/esquema.sql; Hibernate solo lo valida
spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false
spring.jpa.open-in-view=false

# RF-06 — Clima de terceros (OpenWeatherMap). Sin API key el clima se
# desactiva de forma elegante (no aparece en el dashboard, no hay errores).
# Recomendado: definir la clave como variable de entorno (nunca en el repo).
clima.openweather.api-key=${OPENWEATHER_API_KEY:}
# Base URL del proveedor (por defecto la API 2.5 oficial)
# clima.openweather.url=https://api.openweathermap.org/data/2.5
# Minutos de cache por ubicación (Guava) para respetar el límite del plan gratuito
# clima.cache.minutos=30

# Administrador de demostración (admin@agropiura.com). La clave por defecto es
# pública (docs/05-seguridad-y-permisos.md): fuera del entorno local defina ADMIN_DEMO_CLAVE o desactívelo.
agro.demo.admin.habilitado=true
# agro.demo.admin.clave=${ADMIN_DEMO_CLAVE:}

# Errores: nunca exponer trazas ni mensajes internos al usuario
server.error.include-stacktrace=never
server.error.include-message=never
